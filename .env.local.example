# Mavya local environment.
# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Never expose these in client bundles.

# Required. Server-side only. Used by /api/score (vision) and /api/generate (image edit).
OPENAI_API_KEY=sk-...

# Optional. Override the default vision model used for scoring.
# Default: gpt-4o.
# OPENAI_VISION_MODEL=gpt-4o

# Optional. Override the default image generation/edit model used for the
# improved hero photo. Default: gpt-image-2 (current OpenAI state-of-the-art
# image model with /v1/images/edits support).
# OPENAI_IMAGE_MODEL=gpt-image-2

# --- Operational kill switches + limits (see docs/PRODUCTION_READINESS.md) ---

# Set to "true" to disable ALL billable AI (score + checklist + generation).
# AI_DISABLED=true
# Set to "true" to disable generation only (scoring keeps working).
# GENERATION_DISABLED=true
# Global daily ceiling across all users, weighted by action cost. Default 2000.
# GLOBAL_DAILY_AI_ACTIONS=2000
# Enable landing demo states/shortcuts in production builds (dev always on).
# NEXT_PUBLIC_ENABLE_DEMO=1

# Required in Vercel production. Durable rate limits protect OpenAI/Stripe routes
# across serverless instances. Local dev falls back to in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Supabase auth + database ---

# Public, safe to expose in the client bundle. Row Level Security is the real gate.
# Project settings -> Data API (or API): Project URL + anon/public key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SERVER ONLY. Never prefix with NEXT_PUBLIC. Never commit. Used only where RLS
# must be bypassed on the server (rare). Project settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe subscription billing (server only) ---

# Use test-mode values locally and in a test deployment first. Replace all
# three together when switching the production deployment to Stripe live mode.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Protects /api/generate/worker when an external scheduler is used as the
# refinement recovery backstop. Generate a long random value; never expose it.
WORKER_SECRET=
